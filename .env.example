# Copy to .env.local for local development. Never commit .env.local.

# Public URL of the deployed site (used for metadata, sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A fine-grained GitHub token with NO permissions (public data only)
# raises the API rate limit from 60 to 5,000 requests per hour.
# Server-only: it is never sent to the browser because it lacks the NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=
